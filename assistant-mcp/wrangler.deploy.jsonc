{
  "name": "tw-market-research",
  "main": "market_reader_worker.js",
  "compatibility_date": "2026-11-15",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "vars": {
    "SOURCE_BASE_URL": "https://raw.githubusercontent.com/Morris199786/tw-market-monitor/main/",
    "SITE_URL": "https://tw-market-monitor.pages.dev/"
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "REPLACE_WITH_CREATED_KV_NAMESPACE_ID"
    }
  ],
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
